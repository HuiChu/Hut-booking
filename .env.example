# hike.taiwan.gov.tw account
HIKE_USERNAME=your_account
HIKE_PASSWORD=your_password

# Leader (領隊) personal info — required for booking
LEADER_NAME=王小明
LEADER_ID=A123456789
LEADER_PHONE=0912345678
LEADER_BIRTHDAY=1990-01-01

# Optional: NTP server for time sync (defaults to time.stdtime.gov.tw)
NTP_SERVER=time.stdtime.gov.tw

# Optional: log level
LOG_LEVEL=INFO

# Storage paths (defaults under ./storage and ./logs)
STORAGE_DIR=storage
LOGS_DIR=logs
